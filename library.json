{
  "name": "ieee-802_15_4",
  "keywords": "esp32, 802.15.4, ieee",
  "description": "Simplified version of sending and receiving messages over 802.15.4",
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "authors":
  {
    "name": "Johan Böhlin"
  },
  "version": "1.0.2",
  "license": "GPL-3.0-or-later",
  "repository":
  {
    "type": "git",
    "url": "https://github.com/Johboh/ieee-802_15_4.git"
  },
  "build": {
      "libLDFMode": "deep"
  },
  "frameworks": ["espidf"],
  "platforms": ["espressif32"],
  "examples": [
    {
      "name": "ESP-IDF host",
      "base": "examples/espidf/host/main",
      "files": ["main.cpp"]
    },
    {
      "name": "ESP-IDF node",
      "base": "examples/espidf/node/main",
      "files": ["main.cpp"]
    }
  ],
  "dependencies": []
}
